# KINGDROPP environment template (no secrets)
# Copy to .env.local and replace placeholders only for an isolated KINGDROPP deployment.
# Never use Gameon Garb project credentials or service accounts.

# Site identity
APP_URL=
NEXT_PUBLIC_SITE_URL=
DATABASE_URL=
SESSION_SECRET=

# Recovery email — disabled unless explicitly enabled.
KINGDROPP_PASSWORD_RESET_EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Mandatory for production auth/registration/recovery/tracking attempts.
# Use a separate KINGDROPP Upstash Redis REST database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing integrations remain opt-in. Independent provider credentials only.
KINGDROPP_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=

BKASH_MODE=sandbox
BKASH_PUBLIC_ENABLED=false
BKASH_UAT_ENABLED=false
BKASH_BASE_URL=
BKASH_CALLBACK_URL=

NOTIFICATION_WORKER_ENABLED=false
